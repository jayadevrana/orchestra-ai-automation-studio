# Orchestra environment variables.
# Copy this file to .env.local and paste your real keys there (.env.local is gitignored).
# NEVER commit real keys. NEVER paste keys into a chat.

# REQUIRED — the reasoning brain. Plans and runs every workflow.
# Get it: https://platform.claude.com  ->  Settings -> API keys
ANTHROPIC_API_KEY=

# OPTIONAL — enables LIVE web search in the research node.
# Without it, research falls back to model knowledge (clearly flagged in the run log).
# Get it: https://tavily.com  ->  sign in -> API keys (free tier available)
TAVILY_API_KEY=
